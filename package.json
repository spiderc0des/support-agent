{
  "name": "relaypay-support",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "spike:mcp": "tsx spikes/mcp-stub.ts",
    "spike:agent": "tsx spikes/agent-latency.ts",
    "spike:vapi": "tsx spikes/vapi-echo.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:retrieval": "tsx --test tests/retrieval.test.ts",
    "typecheck": "tsc -p .",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "kb:ingest": "tsx scripts/kb-ingest.ts",
    "mcp:dev": "npm run dev -w @relaypay/mcp-server",
    "mcp:start": "npm run start -w @relaypay/mcp-server",
    "lint:skills": "tsx scripts/lint-skills.ts",
    "prompt:size": "tsx scripts/prompt-size.ts",
    "eval": "tsx scripts/eval.ts",
    "web:dev": "npm run dev -w @relaypay/web",
    "web:build": "npm run build -w @relaypay/web",
    "web:start": "npm run start -w @relaypay/web",
    "check": "npm run typecheck && npm run lint:skills && npm test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  }
}
