{
  "name": "RelayPay Support",
  "firstMessage": "Hi, you've reached RelayPay support. How can I help you today?",
  "firstMessageMode": "assistant-speaks-first",
  "firstMessageInterruptionsEnabled": true,
  "stopSpeakingPlan": {
    "numWords": 0,
    "voiceSeconds": 0.2,
    "backoffSeconds": 1
  },
  "model": {
    "provider": "custom-llm",
    "url": "${APP_URL}/api/vapi",
    "model": "relaypay-support-agent"
  },
  "transcriber": {
    "provider": "deepgram",
    "model": "nova-3",
    "language": "en",
    "keyterm": [
      "RelayPay",
      "LagosLedger",
      "NairobiOps",
      "AccraStack",
      "CapeCloud",
      "KigaliWorks",
      "TXN",
      "payout",
      "KYC"
    ]
  },
  "voice": {
    "provider": "vapi",
    "voiceId": "Elliot"
  },
  "server": {
    "url": "${APP_URL}/api/vapi/events",
    "headers": {
      "x-vapi-secret": "${VAPI_WEBHOOK_SECRET}"
    }
  },
  "serverMessages": [
    "status-update",
    "end-of-call-report",
    "user-interrupted"
  ],
  "silenceTimeoutSeconds": 45,
  "maxDurationSeconds": 900,
  "backgroundSound": "off",
  "endCallPhrases": [
    "goodbye from relaypay"
  ],
  "hooks": [
    {
      "on": "customer.speech.timeout",
      "options": {
        "timeoutSeconds": 5,
        "triggerMaxCount": 1,
        "triggerResetMode": "onUserSpeech"
      },
      "do": [
        {
          "type": "say",
          "exact": "I can't hear you. Are you still there?"
        }
      ]
    },
    {
      "on": "customer.speech.timeout",
      "options": {
        "timeoutSeconds": 10,
        "triggerMaxCount": 1,
        "triggerResetMode": "onUserSpeech"
      },
      "do": [
        {
          "type": "say",
          "exact": "I can't hear you. Are you still there?"
        }
      ]
    },
    {
      "on": "customer.speech.timeout",
      "options": {
        "timeoutSeconds": 15,
        "triggerMaxCount": 1,
        "triggerResetMode": "onUserSpeech"
      },
      "do": [
        {
          "type": "say",
          "exact": "I still can't hear anything, so I'll end the call now. Goodbye from RelayPay."
        },
        {
          "type": "tool",
          "tool": {
            "type": "endCall"
          }
        }
      ]
    }
  ]
}
