# Copy to .env.local at the repository root. The scripts, the MCP server and
# the web app all read it (.env.local first, then .env). On Railway, set these
# as service variables instead.

# ---- Supabase -------------------------------------------------------------
# Project Settings > API. The BARE project URL: https://abcd.supabase.co
# (not .../rest/v1/). The client appends the paths itself.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Only for `npm run db:migrate` (Project Settings > Database > Connection string, URI).
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Live agent. Fallback if the eval gate fails: claude-sonnet-5
AGENT_MODEL=claude-haiku-4-5
# Hard cap on model spend per call (USD).
CALL_BUDGET_USD=0.50
# End-of-call summary model; "off" for the record-only summary.
SUMMARY_MODEL=claude-haiku-4-5
# Eval judge (offline only).
JUDGE_MODEL=claude-sonnet-5

# ---- MCP server -----------------------------------------------------------
# Where the agent reaches the tools. Locally: http://localhost:8788/mcp
# On Railway: http://<mcp-service>.railway.internal:<PORT>/mcp
MCP_URL=http://localhost:8788/mcp
# Random, 24+ characters: openssl rand -hex 24
MCP_AUTH_TOKEN=

# ---- Vapi -----------------------------------------------------------------
# Dashboard > API Keys. The private key is for `npm run vapi:sync` only.
VAPI_PRIVATE_KEY=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# Printed by `npm run vapi:sync` on first run.
VAPI_ASSISTANT_ID=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# Shared secret Vapi sends to our endpoints (custom-llm credential and
# x-vapi-secret on server events). openssl rand -hex 24
VAPI_WEBHOOK_SECRET=
# Optional: shown on the voice page once a Vapi number is attached.
NEXT_PUBLIC_SUPPORT_PHONE=

# ---- App ------------------------------------------------------------------
# Public https origin. Vapi must reach it: an ngrok URL locally.
APP_URL=https://your-app.up.railway.app
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app
# Enables POST /api/chat (text channel for testing). Leave empty to disable.
DEV_API_TOKEN=

# ---- Team email notifications (Brevo) ---------------------------------------
# The support team (every support agent and admin) is emailed when a ticket or
# escalation is opened on a call, or when the agent fails mid-call. Sent over
# Brevo's HTTPS API because Railway blocks SMTP. Set these on BOTH Railway
# services (web and mcp): the MCP server sends ticket and escalation emails,
# the web app sends agent-failure emails. Without them nothing is sent and
# each skipped email is recorded on the ticket.
BREVO_API_KEY=
# A sender address verified in Brevo (Senders, Domains & Dedicated IPs → Senders).
MAIL_FROM=
MAIL_FROM_NAME=RelayPay Support
# Which channels email the team (eval runs and tests never do).
NOTIFY_CHANNELS=web_voice,phone


# ---- Callback booking (Google Calendar) -------------------------------------
# Each support agent connects their own Google Calendar on their Profile page;
# callbacks are booked with the first agent, in the admin's order (Admin →
# Callback order), who is working and free then. Set on BOTH services: the web
# app runs the "Connect Google Calendar" sign-in, the MCP server books.
#
# Google Cloud Console → APIs & Services:
#   1. Enable the Google Calendar API.
#   2. OAuth consent screen: External, add the calendar.events and
#      calendar.freebusy scopes, and add each agent's Google account as a
#      test user (or publish the app).
#   3. Credentials → OAuth client ID → Web application. Authorised redirect
#      URI: ${APP_URL}/api/google/callback (and http://localhost:3000/api/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callers' times are read in the zone their browser reports on the "Know me"
# sign-in; phone callers and anyone else use this.
CALLBACK_DEFAULT_TIMEZONE=Africa/Lagos
# Channels that create real calendar events (eval runs and tests never do).
CALLBACK_CHANNELS=web_voice,phone
